{
  "name": "farmacinha-leticia",
  "productName": "Farmacinha Leticia",
  "version": "1.0.0",
  "description": "Controle de medicamentos domésticos da família, com cadastro por foto/vídeo do celular usando IA.",
  "author": "Família Leticia",
  "license": "MIT",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win",
    "pack": "electron-builder --dir"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.122.0",
    "express": "^4.21.2",
    "ffmpeg-static": "^5.3.0",
    "multer": "^2.0.1",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "electron": "^44.0.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.familia.farmacinhaleticia",
    "productName": "Farmacinha Leticia",
    "files": [
      "src/**/*",
      "assets/**/*",
      "node_modules/**/*"
    ],
    "asarUnpack": [
      "node_modules/ffmpeg-static/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Farmacinha Leticia"
    }
  }
}
